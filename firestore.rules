rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile documents
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Curricula created by teachers
    match /curricula/{curriculumId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Student enrollments per curriculum
    match /enrollments/{curriculumId}/students/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Topic completion tracking
    match /topic_completions/{completionId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // Teacher history logs
    match /teacherHistory/{uid}/entries/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Student history logs
    match /studentHistory/{uid}/entries/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // General fallback for authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
